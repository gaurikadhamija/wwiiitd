# ==============================================================================
# WorthWhile Campus Intelligence — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Vite)
# ------------------------------------------------------------------------------
# VITE_API_URL: Public HTTPS URL of the deployed Express backend.
# Set this in your Vercel Project Settings -> Environment Variables.
# Example: https://worthwhile-api.onrender.com
# In local development or AI Studio preview, leave unset to fallback to relative /api.
VITE_API_URL=""

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render / Node.js Service)
# ------------------------------------------------------------------------------
# PORT: Port for the Express server to listen on. Automatically provided by Render.
PORT="3000"

# HOST: Network host interface. Defaults to 0.0.0.0 to accept external traffic.
HOST="0.0.0.0"

# NODE_ENV: Set to 'production' on Render/production, or 'development' locally.
NODE_ENV="development"

# WORTHWHILE_DB_PATH: Path to SQLite database file.
# Defaults to ./data/campus_events.db. If using a persistent disk on Render, point to /var/data/campus_events.db.
WORTHWHILE_DB_PATH="./data/campus_events.db"

# CORS_ORIGIN: Allowed frontend origins for CORS.
# Set to your Vercel URL(s) comma-separated, or '*' for permissive cross-origin requests.
# Example: https://worthwhile-iiitd.vercel.app
CORS_ORIGIN="*"

# ALLOW_DEMO_IDENTITY: Demo student identity bypass (must be false in production).
ALLOW_DEMO_IDENTITY="false"

# ALLOW_DATABASE_RESET: Failsafe against data deletion. Always false in production.
ALLOW_DATABASE_RESET="false"

# ------------------------------------------------------------------------------
# AI & PLATFORM SERVICES
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI event relevance and semantic analysis.
# Automatically injected in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted.
APP_URL="MY_APP_URL"
